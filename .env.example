# AutoApply Cloud — copy to .env.saas.local for local development.
# Never commit populated values. Configure the same server-only values in Vercel.

# Safe browser configuration. The API exposes only these two Supabase values.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SITE_URL=http://127.0.0.1:8000

# Server-only Supabase credential. Never expose this in public/app.js.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Local Supabase CLI only: identity-login provider secret. Keep this distinct from
# GOOGLE_CLIENT_SECRET below, which belongs to the application's Gmail-send client.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Public Cloudflare Turnstile site key. Safe rollout: deploy this public key first,
# verify the widget/CSP, and only then configure its matching secret and enable CAPTCHA
# in Supabase Authentication > Bot and Abuse Protection. Never put that secret here.
TURNSTILE_SITE_KEY=

# Fernet key generated with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# One fixed callback is used by both Gmail paths. Copy this exact URI into every
# Google Web OAuth client; do not substitute a per-user URI or a trailing slash.
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/oauth/google/callback

# Optional platform-managed Google OAuth Web client for Gmail sending. Supplying both
# values makes this the default Connect Gmail path. These do not enable Continue with
# Google; configure that identity provider in Supabase Auth. Leave both blank only if
# users will use the advanced user-managed Web OAuth client path. A Google Cloud API
# key is not a substitute.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Advanced user-managed OAuth client IDs/secrets are entered by authenticated users,
# encrypted with TOKEN_ENCRYPTION_KEY, and stored in a service-role-only database table.
# They are never environment variables or browser-persisted secrets.

# A user's Groq key is intentionally NOT configured here. It stays in that
# user's browser localStorage and is sent transiently in X-Groq-Api-Key.
GROQ_MODEL=openai/gpt-oss-120b

# Product limits.
MAX_RESUME_BYTES=6291456
DEFAULT_DAILY_SEND_CAP=10
OAUTH_STATE_TTL_SECONDS=600
SUPABASE_HTTP_TIMEOUT_SECONDS=15

# Managed-browser support. These are required by the trusted control plane/worker for
# Browserbase Live View and application scan/prefill/submit. Users enter passwords/MFA
# inside Live View; never collect provider passwords in this file or the AutoApply UI.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Empty disables all browser providers. Keep this fail-closed default until staging.
ALLOWED_BROWSER_PROVIDERS=
# Initial reviewed rollout (one-page Google Forms and Greenhouse only):
# ALLOWED_BROWSER_PROVIDERS=google_forms,greenhouse
# Add Lever, Ashby, and Wellfound one at a time only after a controlled canary.
# YC, Cutshort, and Instahyre currently allow isolated login setup only; their
# multi-step application state machines deliberately do not queue form automation.
# ZipRecruiter is intentionally excluded.

# Persistent worker only (not used by the Vercel function). A continuously running
# worker is required for network discovery and managed-browser jobs.
WORKER_ID=autoapply-worker-1
WORKER_POLL_SECONDS=2
# Consecutive empty polls back off toward this ceiling; work resets the delay.
WORKER_MAX_IDLE_POLL_SECONDS=15
WORKER_LEASE_SECONDS=120
WORKER_HEARTBEAT_SECONDS=20
WORKER_LOG_LEVEL=INFO
